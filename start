#!/usr/bin/env bash
# Magic Video 一键启动（Git Bash）：在项目根目录执行 ./start
# Magic Video 默认连接真实数据库 D:\magicvideo\library.db（与 config.DEFAULT_DATA_DIR 一致）。
# 可选：./start --local  改用项目内 data/ 的调试库；./start --debug 打开 DevTools。
# 显式 export 是为了让自动拉起的托盘守护继承同一个数据目录。
set -euo pipefail
cd "$(dirname "$0")"

PY=".venv/Scripts/python.exe"
if [[ ! -x "$PY" ]]; then
  echo "[start] 找不到 .venv/Scripts/python.exe；请先创建虚拟环境并安装依赖" >&2
  exit 1
fi

use_local=0
args=()
for arg in "$@"; do
  if [[ "$arg" == "--local" ]]; then use_local=1; else args+=("$arg"); fi
done

if [[ "$use_local" == 1 ]]; then
  export MAGIC_VIDEO_DATA_DIR="$(cygpath -w "$(pwd)/data")"
else
  export MAGIC_VIDEO_DATA_DIR='D:\magicvideo'
fi

echo "[start] 数据目录 : $MAGIC_VIDEO_DATA_DIR"
echo "[start] 数据库   : $MAGIC_VIDEO_DATA_DIR\\library.db"
echo "[start] 提示      : 再次运行 ./start 会回到已有窗口，不会新开一个"
exec "$PY" run.py "${args[@]}"
